{
  "ServiceName": "devhub-backend",
  "SourceConfiguration": {
    "AutoDeploymentsEnabled": true,
    "AuthenticationConfiguration": {
      "AccessRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/AppRunnerECRAccessRole"
    },
    "ImageRepository": {
      "ImageRepositoryType": "ECR",
      "ImageIdentifier": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/devhub-backend:latest",
      "ImageConfiguration": {
        "Port": "8080",
        "RuntimeEnvironmentVariables": {
          "SPRING_PROFILES_ACTIVE": "prod",
          "EXEC_ENABLED": "false",
          "CORS_ALLOWED_ORIGINS": "https://<YOURNAME>.github.io",
          "DATABASE_URL": "jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>",
          "DATABASE_USERNAME": "<DB_USER>",
          "DATABASE_PASSWORD": "<DB_PASSWORD>",
          "JWT_SECRET": "<RANDOM_32_PLUS_CHARS>"
        }
      }
    }
  },
  "InstanceConfiguration": {
    "Cpu": "1024",
    "Memory": "2048"
  },
  "HealthCheckConfiguration": {
    "Protocol": "HTTP",
    "Path": "/actuator/health",
    "Interval": 10,
    "Timeout": 5,
    "HealthyThreshold": 1,
    "UnhealthyThreshold": 5
  }
}
