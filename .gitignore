### Throwaway local test tooling ###
# jsdom etc. are only used for one-off verification during builds —
# never part of this static-site / Java project.
node_modules/
package.json
package-lock.json
# Scratch verifier scripts (created during a build, removed before committing).
/tmp_*.mjs

### AWS deploy — generated file carries real account ID + Secrets Manager ARNs ###
deploy/aws/apprunner.generated.json

# Design-review screenshots from frontend/tmp_shot.mjs — regenerate, never commit
# (binary PNGs would bloat the Pages deploy artifact for zero user benefit)
frontend/tmp_shots/

# frontend/tmp_* is ALLOWLISTED, not blocklisted. The committed gates are named
# below; everything else matching tmp_* is scratch — one-off probe scripts, gate
# reports, candidate patches, stray screenshots. A blocklist means the next
# throwaway probe with an unforeseen name lands in the repo; an allowlist means
# adding a real tool is a deliberate line in this file.
frontend/tmp*
# ...and any HIDDEN directory under frontend/. Agents and scripts invent their own
# scratch names (.tsconfhf/ was one), so a tmp_* allowlist alone does not hold: a
# 2.1MB verification screenshot reached a pushed commit through `git add -A` before
# this line existed. The site has no legitimate hidden directories.
frontend/.*/
!frontend/tmp_vcheck.mjs
!frontend/tmp_smoke.mjs
!frontend/tmp_assetcheck.mjs
!frontend/tmp_contrast.mjs
!frontend/tmp_shot.mjs
!frontend/tmp_hfapply.mjs
!frontend/tmp_examtell_audit.mjs
!frontend/tmp_hfaudit.mjs
!frontend/tmp_creamrace.mjs
!frontend/tmp_genpracticemap.mjs
# Not a gate — the shared Playwright/browser resolver the four browser-driving
# gates above import. It MUST be allowlisted: without it they fail at import.
!frontend/tmp_pw.mjs
